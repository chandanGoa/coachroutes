  "description": "Full-featured coach management system with MCP server support",
  "main": "dist/index.js",
  "bin": {
    "coachroutes-mcp": "./dist/index.js",
    "coachroutes": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
